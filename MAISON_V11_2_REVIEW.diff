+.project-form--editorial .commission-extra summary:focus-visible{outline:2px solid #474740}
+@media(max-width:760px){.project-form--editorial .commission-extra-grid{grid-template-columns:1fr}.project-form--editorial .commission-extra-grid .wide{grid-column:auto}}
