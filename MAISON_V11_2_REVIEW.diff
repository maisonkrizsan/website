+.project-form--editorial textarea[name=outcome]{min-height:104px}
+.project-form--editorial .commission-extra{grid-column:1/-1;border-top:1px solid #d6d0c5;border-bottom:1px solid #d6d0c5;padding:18px 0;margin-top:4px}
+.project-form--editorial .commission-extra summary{display:flex;justify-content:space-between;gap:12px;align-items:baseline;cursor:pointer;list-style:none;font:500 14px/1.5 Manrope,Arial,sans-serif;outline-offset:4px}
+.project-form--editorial .commission-extra summary::-webkit-details-marker{display:none}
